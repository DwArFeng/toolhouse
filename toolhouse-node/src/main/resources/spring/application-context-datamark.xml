<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:datamark="http://dwarfeng.com/schema/dwarfeng-datamark"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dwarfeng.com/schema/dwarfeng-datamark
        http://dwarfeng.com/schema/dwarfeng-datamark/dwarfeng-datamark.xsd"
>

    <!-- ExecutorInfo 数据标识。 -->
    <datamark:handler
            handler-name="executorInfoDatamarkHandler"
            resource-url="${datamark.executor_info.resource_url}"
            resource-charset="${datamark.executor_info.resource_charset}"
            update-allowed="${datamark.executor_info.update_allowed}"
    />

    <!-- VisualizerInfo 数据标识。 -->
    <datamark:handler
            handler-name="visualizerInfoDatamarkHandler"
            resource-url="${datamark.visualizer_info.resource_url}"
            resource-charset="${datamark.visualizer_info.resource_charset}"
            update-allowed="${datamark.visualizer_info.update_allowed}"
    />

    <!-- User 数据标识。 -->
    <datamark:handler
            handler-name="userDatamarkHandler"
            resource-url="${datamark.user.resource_url}"
            resource-charset="${datamark.user.resource_charset}"
            update-allowed="${datamark.user.update_allowed}"
    />

    <!-- QoS 服务。 -->
    <datamark:qos/>
</beans>
