<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dubbo.apache.org/schema/dubbo
        http://dubbo.apache.org/schema/dubbo/dubbo.xsd"
>

    <!-- region 基础配置 -->

    <dubbo:application name="toolhouse-node">
        <dubbo:parameter key="qos.enable" value="false"/>
    </dubbo:application>

    <!-- Zookeeper 注册中心。 -->
    <dubbo:registry address="${dubbo.registry.zookeeper.address}" timeout="${dubbo.registry.zookeeper.timeout}"/>

    <!-- Dubbo 协议。 -->
    <dubbo:protocol
            name="dubbo" port="${dubbo.protocol.dubbo.port}" host="${dubbo.protocol.dubbo.host}"
            dispatcher="message" threadpool="fixed" threads="100"
    />
    <!-- Hessian 协议。 -->
    <dubbo:protocol name="hessian" port="${dubbo.protocol.hessian.port}" server="jetty"/>

    <!-- 默认使用 dubbo 协议。 -->
    <dubbo:provider protocol="dubbo"/>

    <!-- endregion -->

    <!-- region 服务配置 -->

    <!-- region toolhouse -->

    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.UserMaintainService"
            ref="userMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.PocaMaintainService"
            ref="pocaMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.CabinetMaintainService"
            ref="cabinetMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.CabinetOperateService"
            ref="cabinetOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.FolderMaintainService"
            ref="folderMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.FolderOperateService"
            ref="folderOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.ToolMaintainService"
            ref="toolMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.ToolOperateService"
            ref="toolOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.FavoriteMaintainService"
            ref="favoriteMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.VisualizerInfoMaintainService"
            ref="visualizerInfoMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.VisualizerInfoOperateService"
            ref="visualizerInfoOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.VisualizerSupportMaintainService"
            ref="visualizerSupportMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.ExecutorInfoMaintainService"
            ref="executorInfoMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.ExecutorInfoOperateService"
            ref="executorInfoOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.ExecutorSupportMaintainService"
            ref="executorSupportMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.SessionMaintainService"
            ref="sessionMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.SessionOperateService"
            ref="sessionOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.VariableMaintainService"
            ref="variableMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.VariableOperateService"
            ref="variableOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.TaskMaintainService"
            ref="taskMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.TaskOperateService"
            ref="taskOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.InputItemMaintainService"
            ref="inputItemMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.InputItemOperateService"
            ref="inputItemOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.OutputItemMaintainService"
            ref="outputItemMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.OutputItemOperateService"
            ref="outputItemOperateServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.FileInfoMaintainService"
            ref="fileInfoMaintainServiceImpl"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.FileOperateService"
            ref="fileOperateServiceImpl"
            protocol="hessian"
            group="${dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.toolhouse.stack.service.ExecuteService"
            ref="executeServiceImpl"
            group="${dubbo.provider.group}"
    />

    <!-- endregion -->

    <!-- endregion -->

    <!-- region 引用配置 -->

    <!-- region snowflake -->

    <dubbo:reference
            id="snowflakeGenerateService"
            interface="com.dwarfeng.sfds.stack.service.GenerateService"
            check="false"
            group="${dubbo.consumer.snowflake.group}"
    />

    <!-- endregion -->

    <!-- endregion -->
</beans>
